// Build settings for the example app.

PRODUCT_NAME = EYZFlowPlayerExample
PRODUCT_BUNDLE_IDENTIFIER = com.eyzmedia.eyzflowPlayerIOSExample
MARKETING_VERSION = 0.3.0
CURRENT_PROJECT_VERSION = 1

SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator appletvos appletvsimulator
TARGETED_DEVICE_FAMILY = 1,2,3
IPHONEOS_DEPLOYMENT_TARGET = 16.0
TVOS_DEPLOYMENT_TARGET = 16.0
SUPPORTS_MACCATALYST = NO

SWIFT_VERSION = 6.0
// Embedded frameworks (Google IMA) load from the app's Frameworks folder.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
CODE_SIGN_STYLE = Automatic
ASSETCATALOG_COMPILER_APPICON_NAME =

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = EYZFlow Player
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// Your Apple team for device builds, in a git-ignored file next to this one:
// DEVELOPMENT_TEAM = <team id>
#include? "Team.xcconfig"
